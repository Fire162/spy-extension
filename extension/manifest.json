{
  "manifest_version": 3,
  "name": "Spy Extension - Remote Browser Control",
  "version": "1.4.0",
  "description": "Secure, peer-to-peer remote browser sharing and control with mutual two-party consent.",
  "permissions": [
    "tabCapture",
    "debugger",
    "offscreen",
    "storage",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Spy Extension Remote Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
